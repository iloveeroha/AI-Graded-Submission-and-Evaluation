{
  "name": "coursera-fullstack-frontend",
  "private": true,
  "scripts": {
    "lint": "eslint src --ext .js,.jsx"
  },
  "devDependencies": {
    "eslint": "8.57.1"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "rules": {
      "no-undef": "error",
      "no-unused-vars": "error"
    }
  }
}
